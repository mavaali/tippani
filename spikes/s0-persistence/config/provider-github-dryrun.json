{
  "configurationId": "CFG-PROVIDER-GITHUB-DRYRUN",
  "adapter": "github",
  "backingPath": "github",
  "platform": "windows-ntfs",
  "scale": "small",
  "runId": "s0-provider-github-dryrun",
  "syntheticDataOnly": true,
  "dryRun": true,
  "budgets": {
    "maxOperations": 100,
    "maxDurationMs": 300000,
    "maxObjects": 10000,
    "maxBytes": 104857600
  },
  "sandbox": {
    "kind": "provider-template",
    "approved": true,
    "allowListed": true,
    "identityLabel": "Synthetic Sandbox Identity (template - replace before live run)",
    "identityVerified": true,
    "corporateFallbackDisabled": true,
    "defaultBranchExcluded": true,
    "ownershipMarker": "tippani-s0:s0-provider-github-dryrun",
    "namespace": "tippani-s0/s0-provider-github-dryrun",
    "coordinates": {
      "owner": "syn-github-org",
      "repository": "syn-s0-repo",
      "ref": "refs/heads/tippani-s0/s0-provider-github-dryrun/main"
    },
    "dryRunOperations": [
      "connect",
      "put-workspace",
      "get-workspace",
      "export-history"
    ],
    "cleanup": {
      "manifestId": "syn-cleanup-s0-provider-github-dryrun",
      "expiresAt": "2000-01-02T00:00:00.000Z"
    }
  },
  "scenarioIds": [
    "S0-COL-002",
    "S0-COL-003",
    "S0-COL-006",
    "S0-BCK-004",
    "S0-BCK-006",
    "S0-PER-004"
  ]
}

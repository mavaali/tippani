{
  "configurationId": "CFG-ONEDRIVE-LIVE",
  "adapter": "onedrive",
  "backingPath": "onedrive",
  "applicabilityProfile": "onedrive",
  "platform": "windows-ntfs",
  "scale": "small",
  "runId": "s0-onedrive-live",
  "syntheticDataOnly": true,
  "dryRun": false,
  "budgets": {
    "maxOperations": 100,
    "maxDurationMs": 300000,
    "maxObjects": 10000,
    "maxBytes": 104857600
  },
  "sandbox": {
    "kind": "provider-live",
    "approved": true,
    "allowListed": true,
    "identityLabel": "Live delegated identity (supplied at runtime)",
    "identityVerified": true,
    "corporateFallbackDisabled": true,
    "defaultBranchExcluded": true,
    "ownershipMarker": "tippani-s0:s0-onedrive-live",
    "namespace": "tippani-s0/s0-onedrive-live",
    "syncProfile": {
      "syncRootEnv": "S0_ONEDRIVE_SYNC_ROOT",
      "clientIdentityEnv": "S0_SYNC_CLIENT_IDENTITY",
      "clientStateEnv": "S0_SYNC_CLIENT_STATE",
      "requiredClientState": "verified-signed-in",
      "requireIndependentClients": true,
      "retainedEvidenceEnv": "S0_SYNC_CONFLICT_EVIDENCE",
      "signerPublicKeyEnv": "S0_SYNC_SIGNER_PUBLIC_KEY",
      "trustedSignerFingerprint": "sha256:REPLACE-WITH-APPROVED-SIGNER-SPKI-FINGERPRINT"
    },
    "coordinates": {
      "driveId": "supplied at runtime via S0_ONEDRIVE_DRIVE_ID",
      "folder": "supplied at runtime via S0_ONEDRIVE_FOLDER"
    },
    "dryRunOperations": [
      "ensure-folder",
      "put-run-marker",
      "put-content",
      "get-content",
      "list-children",
      "delete-folder"
    ],
    "cleanup": {
      "manifestId": "syn-cleanup-s0-onedrive-live",
      "retentionHours": 24
    }
  }
}
